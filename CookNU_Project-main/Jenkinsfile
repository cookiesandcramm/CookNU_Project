pipeline {
    agent any

    environment {
        // Jenkins assigns BUILD_NUMBER automatically; use it to tag each build.
        TAG = "${BUILD_NUMBER}"
        COMPOSE_FILE = "docker-compose.yml"
    }

    triggers {
        // Poll Git every 2 minutes as a fallback if a webhook is not available.
        pollSCM('H/2 * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                // Basic checks for the split frontend files.
                sh '''
                    test -s frontend/index.html
                    test -s frontend/app.css
                    test -s frontend/app.js
                    test -s frontend/ui.js
                    grep -q 'app.css' frontend/index.html
                    grep -q 'app.js' frontend/index.html
                '''
                // Backend unit tests run INSIDE Docker (the "test" stage of each
                // Dockerfile). If any test fails, docker build fails, this stage
                // fails, and the pipeline stops before Build Images / Deploy.
                sh 'docker build --target test -t cooknu-auth-service:test ./auth-service'
                sh 'docker build --target test -t cooknu-recipe-service:test ./recipe-service'
                sh 'docker build --target test -t cooknu-notification-service:test ./notification-service'
            }
        }

        stage('Build Images') {
            steps {
                sh 'TAG=$TAG docker compose -f "$COMPOSE_FILE" build'
            }
        }

        stage('Deploy') {
            steps {
                sh 'TAG=$TAG docker compose -f "$COMPOSE_FILE" up -d --remove-orphans'
            }
        }

        stage('Smoke Test') {
            steps {
                sh '''
                    set -eu
                    for attempt in $(seq 1 15); do
                      if curl --fail --silent http://host.docker.internal:8080/ > /dev/null; then
                        echo "Frontend is responding through the reverse proxy."
                        exit 0
                      fi
                      sleep 2
                    done
                    echo "Smoke test failed: proxy did not respond."
                    exit 1
                '''
                // Backend end-to-end check through the proxy (auth -> recipes -> hearts -> notifications -> database).
                sh 'BASE_URL=http://host.docker.internal:8080 sh scripts/smoke-test.sh'
            }
        }
    }

    post {
        success {
            echo "Cook'N U deployment succeeded. Image tag: ${TAG}"
        }
        failure {
            echo "Pipeline failed. Check the stage logs; deployment may need recovery."
        }
        always {
            echo "Jenkins build ${BUILD_NUMBER} finished with status: ${currentBuild.currentResult}"
        }
    }
}
