
# Database (used by the database container AND the backend services)
POSTGRES_DB=cooknu_db
POSTGRES_USER=cooknu_user
POSTGRES_PASSWORD=replace_with_a_local_password

# Secret used to sign login tokens (JWT). Must be the same for all backend
# services and at least 16 characters. Generate one with:  openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# Application configuration
TAG=local
